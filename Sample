<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Arc Endurance</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: Arial, Helvetica, sans-serif;
    line-height:1.6;
    color:#ffffff;
    background:#0f3d2e;
}

section{
    padding:80px 10%;
}

.container{
    max-width:1200px;
    margin:auto;
}

h1,h2,h3{
    margin-bottom:20px;
}

p{
    margin-bottom:15px;
}

.btn{
    display:inline-block;
    padding:14px 28px;
    background:white;
    color:#0f3d2e;
    text-decoration:none;
    border-radius:6px;
    font-weight:bold;
    margin-top:20px;
}

.hero{
    min-height:90vh;
    display:flex;
    align-items:center;
    text-align:center;
}

.hero h1{
    font-size:4rem;
}

.hero p{
    max-width:700px;
    margin:20px auto;
    font-size:1.2rem;
}

.light{
    background:#ffffff;
    color:#222;
}

.grid{
    display:grid;
    gap:30px;
}

.two-col{
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
}

.three-col{
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
}

.card{
    padding:30px;
    border-radius:10px;
    background:rgba(255,255,255,.08);
}

.light .card{
    background:#f4f4f4;
}

.placeholder-image{
    height:250px;
    border:2px dashed #bbb;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:20px;
}

.testimonial{
    font-style:italic;
}

.cta{
    text-align:center;
}

form{
    max-width:700px;
    margin:40px auto 0;
    display:grid;
    gap:15px;
}

input, textarea{
    padding:14px;
    border:none;
    border-radius:6px;
}

footer{
    text-align:center;
    padding:40px;
}
</style>
</head>
<body>

<section class="hero">
    <div class="container">
        <h1>ARC ENDURANCE</h1>
        <p>
            Short mission statement describing your coaching philosophy.
        </p>

        <a href="#apply" class="btn">Apply for Coaching</a>
    </div>
</section>

<section>
    <div class="container">
        <h2>Your Coaching Philosophy</h2>

        <div class="grid two-col">
            <div>
                <p>
                    Explain the pillars of your coaching approach.
                </p>

                <p>
                    Describe how you help athletes improve performance,
                    remain healthy, and balance training with life.
                </p>
            </div>

            <div class="placeholder-image">
                Add Image
            </div>
        </div>
    </div>
</section>

<section class="light">
    <div class="container">
        <h2>Who We Help</h2>

        <div class="grid three-col">
            <div class="card">
                <h3>Beginner Runners</h3>
                <p>Add description.</p>
            </div>

            <div class="card">
                <h3>Half Marathoners</h3>
                <p>Add description.</p>
            </div>

            <div class="card">
                <h3>Marathon Athletes</h3>
                <p>Add description.</p>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <h2>What's Included</h2>

        <div class="grid three-col">
            <div class="card">
                <h3>Custom Training</h3>
            </div>

            <div class="card">
                <h3>Weekly Check-Ins</h3>
            </div>

            <div class="card">
                <h3>Email & Text Support</h3>
            </div>

            <div class="card">
                <h3>Race Planning</h3>
            </div>

            <div class="card">
                <h3>Workout Analysis</h3>
            </div>

            <div class="card">
                <h3>Goal Setting</h3>
            </div>
        </div>
    </div>
</section>

<section class="light">
    <div class="container">
        <h2>Meet Your Coach</h2>

        <div class="grid two-col">
            <div class="placeholder-image">
                Coach Photo
            </div>

            <div>
                <h3>Your Name</h3>

                <p>
                    Add running background.
                </p>

                <p>
                    Add coaching credentials.
                </p>

                <p>
                    Add personal coaching philosophy.
                </p>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <h2>Athlete Success Stories</h2>

        <div class="grid three-col">
            <div class="card testimonial">
                Add testimonial here.
            </div>

            <div class="card testimonial">
                Add testimonial here.
            </div>

            <div class="card testimonial">
                Add testimonial here.
            </div>
        </div>
    </div>
</section>

<section class="light cta" id="apply">
    <div class="container">
        <h2>Start Your Journey</h2>

        <p>
            Add a short call to action.
        </p>

        <!-- Replace with Google Form link -->
        <a href="#" class="btn">Complete Intake Form</a>

        <div style="margin-top:40px;">
            <div class="placeholder-image" style="height:200px;">
                QR Code
            </div>
        </div>

        <form>
            <input type="text" placeholder="Name">

            <input type="email" placeholder="Email">

            <input type="text" placeholder="Goal Race">

            <textarea rows="5" placeholder="Tell us about your goals"></textarea>

            <input type="submit" value="Submit">
        </form>
    </div>
</section>

<footer>
    © 2026 Arc Endurance
</footer>

</body>
</html>
